    <!-- JavaScript to disable the browser's back button functionality -->
    <script>
        // Push the current URL into the history state
        history.pushState(null, null, document.URL);
        window.addEventListener('popstate', function () {
            // Prevent navigation by pushing the current URL again on popstate event
