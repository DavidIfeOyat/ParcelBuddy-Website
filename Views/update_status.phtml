                // Display each status text as an option in the dropdown
                foreach ($statuses as $status) {
                    echo '<option value="' . $status['idstatus'] . '" ' . ($deliveryInfo['status_num'] == $status['idstatus'] ? 'selected' : '') . '>' . $status['status_text'] . '</option>';
                }
                ?>
            </select>
        </div>
        <div class="update no-radius">
            <button type="submit" class="btn btn-primary text-center">Update Delivery</button>
        </div>
    </form>
