<script>
    document.addEventListener('DOMContentLoaded', function() {
        var searchInput = document.getElementById('search');
        var suggestionList = document.getElementById('suggestion-list');

        // Autocomplete function
        searchInput.addEventListener('input', function() {
            var searchTerm = this.value;

            // Minimum characters before triggering autocomplete
            if (searchTerm.length >= 2) {
                // Fetch suggestions
                fetch('suggestdeliverers.php?term=' + searchTerm)
                    .then(response => response.json())
                    .then(data => {
                        // Clear previous suggestions
                        suggestionList.innerHTML = '';
                        // Display new suggestions
                        data.forEach(function(suggestion) {
                            var suggestionItem = document.createElement('li');

                            // Display the additional fields in the suggestion list
                            suggestionItem.textContent = suggestion;

                            suggestionItem.addEventListener('click', function() {
                                // Set selected suggestion to the search input
                                searchInput.value = suggestion;
                                // Clearing the suggestion list
                                suggestionList.innerHTML = '';
                            });

                            suggestionList.appendChild(suggestionItem);
                        });

                        // Display suggestion list
                        suggestionList.style.display = 'block';
                    })
                    .catch(error => console.error('Error fetching suggestions:', error));
            } else {
                // Hide suggestion list when characters are less than 2
                suggestionList.style.display = 'none';
            }
        });

        // Hide suggestion list when clicking outside
        document.addEventListener('click', function(event) {
            var target = event.target;
            if (target.id !== 'search') {
                suggestionList.style.display = 'none';
            }
        });
    });
</script>
