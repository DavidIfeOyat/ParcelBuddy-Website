<!-- Add Bootstrap JS -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.2.0/dist/js/bootstrap.bundle.min.js" integrity="sha384-pzjw8Yp5BX5PWlP1Uf/cKzr0q5zSLPp/BEjZR5AjGOgYzp4fQsk2taQRIqHsbgRS" crossorigin="anonymous"></script>

<script>
    // This script handles several interactions on the manager page including autocomplete,...
    // ...sorting data, and applying status filters.
    document.addEventListener('DOMContentLoaded', function() {
        // Grab references to important DOM elements used in multiple functions
        var searchInput = document.getElementById('search');
        var suggestionList = document.getElementById('suggestion-list');
        var sortOrderSelect = document.getElementById('sortOrder');
        var filterBtn = document.getElementById('filterBtn');
        var statusFilterSelect = document.getElementById('statusFilter');

        // Set up the autocomplete functionality for the search input.
        // This enhances user experience by providing real-time suggestions as they type.
        searchInput.addEventListener('input', function() {
            var searchTerm = this.value;

            // Only trigger autocomplete after 2 or more characters have been typed.
            // This helps reduce load on the server and prevents too broad suggestions.
            if (searchTerm.length >= 2) {
                fetch('autocomplete.php?term=' + searchTerm)
                    .then(response => response.json())
                    .then(data => {
                        suggestionList.innerHTML = ''; // Clear any previous suggestions
                        data.forEach(function(suggestion) {
                            var suggestionItem = document.createElement('li');
                            suggestionItem.innerHTML = `<strong></strong> ${suggestion.full_name},
                                <strong> </strong> &#128205;${suggestion.address_1},
                                <strong> </strong> ${suggestion.postcode},
                                <strong> </strong> &#128666; ${suggestion.username},
                                <strong> </strong> Latitude: ${suggestion.lat},
                                <strong> </strong> Longitude: ${suggestion.longitude}`;

                            suggestionItem.addEventListener('click', function() {
                                searchInput.value = suggestion.full_name; // Fill input on click
                                suggestionList.innerHTML = ''; // This clears the list after selection
                            });
                            suggestionList.appendChild(suggestionItem);
                        });

                        suggestionList.style.display = 'block'; // Show suggestions
                    })
                    .catch(error => console.error('Error fetching suggestions:', error));
            } else {
                suggestionList.style.display = 'none'; // Hide suggestions if input is too short
            }
        });

        // An event listener to the sort order dropdown to dynamically change
        // the sort order of the data displayed on the page.
        document.getElementById('sortButton').addEventListener('click', function() {
            var sortOrder = sortOrderSelect.value;
            window.location.href = 'manager_page.php?sort=' + sortOrder;
        });


        // status filter redirecting to the initial page
        // the page to in.clude the selected status filter in the query parameters
        filterBtn.addEventListener('click', function() {
            var status = statusFilterSelect.value;
            window.location.href = 'manager_page.php?status=' + status; // Apply status filter
        });

        // this enhances usability by hiding the suggestion list when the user clicks outside of the search input.
        document.addEventListener('click', function(event) {
            if (event.target.id !== 'search') {
                suggestionList.style.display = 'none'; // suggestions list closes once the user clicks outside
            }
        });
    });
</script>

